# Переменные для Nginx (берутся из docker-compose.yml)
API_URL=https://appninjabot.ru/api
WS_URL=wss://appninjabot.ru
NODE_ENV=production

# Переменные для базы данных PostgreSQL (берутся сервисом postgres и бэкендами)
POSTGRES_DB=appninjabot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres # ВАЖНО: Проверь этот пароль! Это пароль от SSH, он может быть другим для базы.

# Другие переменные окружения, если нужны для других сервисов...
# Например, токены для бота, секретные ключи и т.д.
# BOT_TOKEN=ВАШ_ТЕЛЕГРАМ_БОТ_ТОКЕН
# SECRET_KEY=ВАШ_СЕКРЕТНЫЙ_КЛЮЧ_DJANGO_FLASK 