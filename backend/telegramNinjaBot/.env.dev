# --- Тип бота ---
# 'main' - основной бот приложения (Flouix_bot) - токен обязателен
# 'company' - бот компании - токен загружается из БД
BOT_TYPE=company

# --- Токен бота ---
# Для основного бота (BOT_TYPE=company): токен обязателен, захардкожен здесь
# Для ботов компаний (BOT_TYPE=company): можно указать для поиска в БД, или использовать COMPANY_BOT_ID
# ВАЖНО: Это токен основного бота приложения (Flouix_bot), НЕ бота компании!
BOT_TOKEN=8012479473:AAHHMhUpZb2XD_08Plv_o5mr_YUMbMLYhUw

# --- Для ботов компаний ---
COMPANY_BOT_ID=1  # ID бота в таблице company_bots (опционально)

# --- Username основного бота для авторизации ---
AUTH_BOT_USERNAME=Flouix_bot

DEBUG=true
ENVIRONMENT=development
API_URL=http://server:8000
USE_DATABASE=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=appninjabot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Настройки Webhook для разработки ---
# Замените <your_cloudflare_dev_subdomain> на ваш реальный поддомен из Cloudflare Tunnel
WEBHOOK_URL="https://dev-bot.appninjabot.ru"
WEBHOOK_PATH="/api/telegram/webhook_dev"
WEBHOOK_SECRET="a_simple_dev_secret_12345"
WEB_APP_URL="https://dev-bot.appninjabot.ru" # URL фронтенд приложения 