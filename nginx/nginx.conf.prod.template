events {
    worker_connections 1024;
}

http {
    # DNS resolver для Docker сети
    resolver 127.0.0.11 valid=30s;
    
    # Исправление ошибки server_names_hash
    server_names_hash_bucket_size 128;
    
    # MIME types
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Cloudflare Real IP configuration
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2c0f:f248::/32;
    set_real_ip_from 2a06:98c0::/29;

    real_ip_header CF-Connecting-IP;

    # Основные настройки
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    types_hash_max_size 2048;
    server_tokens off;

    # Настройки буферов и таймаутов
    client_body_buffer_size 10K;
    client_header_buffer_size 8k;
    client_max_body_size 200m;
    large_client_header_buffers 4 16k;

    # Сжатие
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # WebSocket
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Upstream удален - используем прямой proxy_pass для избежания проблем с ERR_CONNECTION_RESET

# Маппинг больше не нужен - используем прямую проверку в location

    # Основной сервер (appninjabot.ru)
    server {
        listen 80;
        listen [::]:80;
        server_name appninjabot.ru www.appninjabot.ru c8e767f0-ac37-4f85-88bd-7ce8bceb888c.selcdn.net;
        
        # Важно для корректной работы с URL-encoded символами
        charset utf-8;

        # Логи
        access_log /var/log/nginx/access.log combined buffer=512k flush=1m;
        error_log /var/log/nginx/error.log warn;

        # Frontend (Serve static files from within the image)
        location / {
            root /usr/share/nginx/html;   # Root directory for static files
            index index.html index.htm;     # Default file to serve
            try_files $uri $uri/ /index.html; # Handles SPA routing

            # Optional: Add caching headers for static assets
            location ~* \.(?:css|js|map|jpe?g|png|gif|ico|svg|woff2?|ttf|eot)$ {
                expires 7d; # Cache for 7 days
                access_log off; # Don't log access to static files
                add_header Cache-Control "public";
            }
        }

        # API endpoints without trailing slash
        location = /api {
            return 301 /api/;
        }

        # Write-offs photos specific rule (HIGH PRIORITY)
        location ^~ /v1/write-offs/photos/ {
            # Для URL начинающихся с /v1/ добавляем /api префикс, сохраняя оригинальный путь
            set $final_uri /api$uri;
            
            # Проксируем с исправленным URI
            proxy_pass http://server:8000$final_uri$is_args$args;

            # АНТИ-КЭШ ЗАГОЛОВКИ ДЛЯ ВСЕХ API
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            add_header X-Content-Type-Options "nosniff" always;

            # Стандартные заголовки проксирования
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header CF-IPCountry $http_cf_ipcountry;
            proxy_set_header CF-RAY $http_cf_ray;
            proxy_set_header CF-Visitor $http_cf_visitor;

            # Важно для WSS и HTTPS!
            proxy_set_header X-Forwarded-Ssl on;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Таймауты
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;

            # Буферизация
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 16 4k;
            proxy_busy_buffers_size 8k;

            # Кодировка для URL
            proxy_set_header Accept-Charset utf-8;
            
            # Дополнительная защита от 502 ошибок
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 1;
            proxy_next_upstream_timeout 10s;

            # Логирование для отладки
            access_log /var/log/nginx/api_access.log combined;
            error_log /var/log/nginx/api_error.log warn;
        }

        # WebSocket endpoints (ДОЛЖНЫ БЫТЬ ПЕРЕД ОБЩИМ ПРАВИЛОМ!)
        location ~ ^/(api/ws|socket\.io)/ {
            proxy_pass http://websocket:8001;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;

            # Передаем IP и заголовки с Cloudflare
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header CF-IPCountry $http_cf_ipcountry;
            proxy_set_header CF-RAY $http_cf_ray;
            proxy_set_header CF-Visitor $http_cf_visitor;

            # Важно для WSS!
            proxy_set_header X-Forwarded-Ssl on;

            # Увеличиваем таймауты
            proxy_read_timeout 300;
            proxy_send_timeout 300;
            proxy_connect_timeout 300;

            # Отключаем буферизацию
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            proxy_redirect off;

            # Для отладки сохраняем больше логов
            access_log /var/log/nginx/websocket_access.log;
            error_log /var/log/nginx/websocket_error.log debug;
        }

        # УНИВЕРСАЛЬНОЕ ПРАВИЛО ДЛЯ ВСЕХ API ЭНДПОИНТОВ
        # Покрывает: /api/*, /v1/*, /couriers/*, /users/* и любые другие API пути
        location ~* ^/(api|v1|couriers|users|shifts|reserves|groups|inventory|write-offs)(/.*)?$ {

            # Для URL начинающихся с /v1/ добавляем /api префикс, сохраняя исходное кодирование
            set $final_uri $request_uri;
            if ($request_uri ~ ^/v1/(.*)$) {
                set $final_uri /api/v1/$1;
            }
            
            # Проксируем с исправленным URI, сохраняя исходное кодирование
            proxy_pass http://server:8000$final_uri;

            # АНТИ-КЭШ ЗАГОЛОВКИ ДЛЯ ВСЕХ API
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            add_header X-Content-Type-Options "nosniff" always;
            
            # Увеличиваем таймауты для Cloudflare
            add_header X-Requested-With "XMLHttpRequest" always;
            add_header X-Frame-Options "SAMEORIGIN" always;

            # Стандартные заголовки проксирования
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header CF-IPCountry $http_cf_ipcountry;
            proxy_set_header CF-RAY $http_cf_ray;
            proxy_set_header CF-Visitor $http_cf_visitor;

            # Важно для WSS и HTTPS!
            proxy_set_header X-Forwarded-Ssl on;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Таймауты
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;

            # Буферизация
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 16 4k;
            proxy_busy_buffers_size 8k;

            # Кодировка для URL
            proxy_set_header Accept-Charset utf-8;
            
            # Дополнительная защита от 502 ошибок
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 1;
            proxy_next_upstream_timeout 10s;

            # Логирование для отладки
            access_log /var/log/nginx/api_access.log combined;
            error_log /var/log/nginx/api_error.log warn;
        }

        # User photos static files
        location /users-photo/ {
            alias /app/shared/users-photo/;
            expires 7d; # Cache for 7 days
            access_log off;
            add_header Cache-Control "public";
        }

        # Маршрут для отправки сообщений от шедулера к боту
        location /send_message {
            proxy_pass http://bot:8003/send_message;
            
            # Анти-кэш заголовки
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            expires 0;
            
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
            
            # Логи
            access_log /var/log/nginx/scheduler_bot_proxy_access.log;
            error_log /var/log/nginx/scheduler_bot_proxy_error.log warn;
        }

        # Remove or update this location if test client is not needed
        location /test-client {
            alias /var/www/appninjabot/websocket-service/; # Check if this path exists/needed
            index index.html;
        }

        # Remove or update this location if health check is handled differently
        location /health {
            proxy_pass http://websocket:8001; # Or point to server health endpoint
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        # Мониторинг - Prometheus метрики
        location /metrics {
            # Проксируем на разные сервисы в зависимости от параметра
            set $target_service server;
            if ($arg_service = "websocket") {
                set $target_service websocket;
            }
            if ($arg_service = "server") {
                set $target_service server;
            }
            
            proxy_pass http://$target_service:8000/metrics;
            if ($arg_service = "websocket") {
                proxy_pass http://$target_service:8001/metrics;
            }
            
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
            
            # Заголовки для метрик
            add_header Content-Type text/plain;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }

        # Диагностический endpoint для проверки config.js
        location = /debug/config-status {
            return 200 '{"status":"ok","config_path":"/usr/share/nginx/html/config.js","timestamp":"$time_iso8601","user_agent":"$http_user_agent"}';
            add_header Content-Type application/json;
            add_header Cache-Control "no-store, must-revalidate";
            access_log /var/log/nginx/config_debug_access.log combined;
        }

        location = /config.js {
            root /usr/share/nginx/html;
            
            # Агрессивные anti-cache заголовки для мобильных
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
            add_header Pragma "no-cache";
            add_header Expires "0";
            add_header Last-Modified $date_gmt;
            add_header ETag "";
            add_header X-Debug-ConfigJS "served-by-nginx-$time_iso8601";
            
            # Включаем логирование для отладки
            access_log /var/log/nginx/config_js_access.log combined;
            error_log /var/log/nginx/config_js_error.log debug;
            
            # Добавляем заголовки для мобильной отладки
            add_header X-Content-Type-Options nosniff;
            add_header X-Frame-Options DENY;
            add_header Vary "User-Agent";
            
            # Отключаем кэширование на уровне nginx
            expires off;
            etag off;
        }
    }

    # Сервер для бота
    server {
        listen 80;
        server_name bot.appninjabot.ru localhost;
        
        # Важно для корректной работы с URL-encoded символами
        charset utf-8;
        
        # Увеличиваем лимиты для больших URL
        client_max_body_size 100M;
        large_client_header_buffers 4 32k;

        # УНИВЕРСАЛЬНЫЕ WEBHOOK ENDPOINTS для всех ботов
        # Поддерживает динамические пути:
        # - /api/telegram/webhook/main - основной бот -> bot-main
        # - /api/telegram/webhook/{bot_id} - боты компаний -> bot-companies
        
        # Webhook для основного бота
        location = /api/telegram/webhook/main {
             proxy_pass http://bot-main:8003;
             proxy_http_version 1.1;
             proxy_set_header Host $host;
             proxy_set_header X-Real-IP $http_cf_connecting_ip;
             proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
             proxy_set_header X-Forwarded-Proto $scheme;
             proxy_set_header X-Forwarded-Host $host;
             proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
             proxy_set_header CF-IPCountry $http_cf_ipcountry;
             proxy_set_header CF-RAY $http_cf_ray;
             proxy_set_header X-Telegram-Bot-Api-Secret-Token $http_x_telegram_bot_api_secret_token;
             proxy_pass_request_headers on;
             proxy_read_timeout 60s;
             proxy_send_timeout 60s;
             proxy_connect_timeout 10s;
        }
        
        # Webhook для ботов компаний (динамический путь с ID бота)
        location ~ ^/api/telegram/webhook/(\d+)$ {
             # Проксируем на bot-companies, который содержит универсальный endpoint
             proxy_pass http://bot-companies:8003;
             proxy_http_version 1.1;
             proxy_set_header Host $host;
             proxy_set_header X-Real-IP $http_cf_connecting_ip;
             proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
             proxy_set_header X-Forwarded-Proto $scheme;
             proxy_set_header X-Forwarded-Host $host;
             proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
             proxy_set_header CF-IPCountry $http_cf_ipcountry;
             proxy_set_header CF-RAY $http_cf_ray;
             proxy_set_header X-Telegram-Bot-Api-Secret-Token $http_x_telegram_bot_api_secret_token;
             proxy_pass_request_headers on;
             proxy_read_timeout 60s;
             proxy_send_timeout 60s;
             proxy_connect_timeout 10s;
        }
        
        # Fallback для старого webhook пути (обратная совместимость)
        location = ${WEBHOOK_PATH} {
             # Проксируем на bot-main для старого формата
             proxy_pass http://bot-main:8003;
             proxy_http_version 1.1;
             proxy_set_header Host $host;
             proxy_set_header X-Real-IP $http_cf_connecting_ip;
             proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
             proxy_set_header X-Forwarded-Proto $scheme;
             proxy_set_header X-Forwarded-Host $host;
             proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
             proxy_set_header CF-IPCountry $http_cf_ipcountry;
             proxy_set_header CF-RAY $http_cf_ray;
             proxy_set_header X-Telegram-Bot-Api-Secret-Token $http_x_telegram_bot_api_secret_token;
             proxy_pass_request_headers on;
             proxy_read_timeout 60s;
             proxy_send_timeout 60s;
             proxy_connect_timeout 10s;
        }

        # Write-offs photos specific rule (HIGH PRIORITY)
        location ^~ /v1/write-offs/photos/ {
            # Для URL начинающихся с /v1/ добавляем /api префикс, сохраняя оригинальный путь
            set $final_uri /api$uri;
            
            # Проксируем с исправленным URI
            proxy_pass http://server:8000$final_uri$is_args$args;

            # АНТИ-КЭШ ЗАГОЛОВКИ ДЛЯ ВСЕХ API
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            add_header X-Content-Type-Options "nosniff" always;

            # Стандартные заголовки проксирования
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            # Важно для WSS и HTTPS!
            proxy_set_header X-Forwarded-Ssl on;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Таймауты
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;

            # Буферизация
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 16 4k;
            proxy_busy_buffers_size 8k;

            # Кодировка для URL
            proxy_set_header Accept-Charset utf-8;
            
            # Дополнительная защита от 502 ошибок
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 1;
            proxy_next_upstream_timeout 10s;

            # Логирование для отладки
            access_log /var/log/nginx/api_access.log combined;
            error_log /var/log/nginx/api_error.log warn;
         }

        # API endpoints для localhost (дублируем из основного сервера)
        location ~ ^/(api|v1|couriers|users|shifts|reserves|groups|inventory|write-offs)(/.*)?$ {
            # Для URL начинающихся с /v1/ добавляем /api префикс, сохраняя исходное кодирование
            set $final_uri $request_uri;
            if ($request_uri ~ ^/v1/(.*)$) {
                set $final_uri /api/v1/$1;
            }
            
            # Проксируем с исправленным URI, сохраняя исходное кодирование
            proxy_pass http://server:8000$final_uri;

            # АНТИ-КЭШ ЗАГОЛОВКИ ДЛЯ ВСЕХ API
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            add_header X-Content-Type-Options "nosniff" always;

            # Стандартные заголовки проксирования
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            # Важно для WSS и HTTPS!
            proxy_set_header X-Forwarded-Ssl on;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Таймауты
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;

            # Буферизация
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 16 4k;
            proxy_busy_buffers_size 8k;

            # Кодировка для URL
            proxy_set_header Accept-Charset utf-8;
            
            # Дополнительная защита от 502 ошибок
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 1;
            proxy_next_upstream_timeout 10s;

            # Логирование для отладки
            access_log /var/log/nginx/api_access.log combined;
            error_log /var/log/nginx/api_error.log warn;
        }

        # На все остальные запросы к этому поддомену отвечаем 404
        location / {
            return 404;
        }
    }

    # Сервер для мониторинга (Grafana + Prometheus)
    server {
        listen 80;
        server_name monitoring.appninjabot.ru localhost;
        
        # Базовая аутентификация для защиты мониторинга
        auth_basic "Monitoring Access";
        auth_basic_user_file /etc/nginx/.htpasswd;
        
        # Grafana
        location / {
            proxy_pass http://grafana:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            
            # WebSocket support для Grafana live updates
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }
        
        # Prometheus (для прямого доступа к метрикам)
        location /prometheus/ {
            rewrite ^/prometheus/(.*) /$1 break;
            proxy_pass http://prometheus:9090;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }
        
        # Node Exporter метрики
        location /node-exporter/ {
            rewrite ^/node-exporter/(.*) /$1 break;
            proxy_pass http://node-exporter:9100;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }
        
        # cAdvisor метрики
        location /cadvisor/ {
            rewrite ^/cadvisor/(.*) /$1 break;
            proxy_pass http://cadvisor:8080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }
    }

    # Сервер для лендинга (flowixdata.ru) - HTTP редирект на HTTPS
    server {
        listen 80;
        listen [::]:80;
        server_name flowixdata.ru www.flowixdata.ru;

        # Логи
        access_log /var/log/nginx/landing_access.log combined;
        error_log /var/log/nginx/landing_error.log warn;

        # Редирект на HTTPS
        return 301 https://$server_name$request_uri;
        
        # Специальная обработка статических файлов Next.js (высокий приоритет)
        # Обработка всех статических файлов Next.js (_next/static, _next/image, и т.д.)
        location ~ ^/_next/ {
            proxy_pass http://flowix-landing:3002;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Закрываем соединение после каждого запроса (решает ERR_CONNECTION_RESET)
            proxy_set_header Connection "close";
            
            # Кэширование статических файлов
            add_header Cache-Control "public, immutable, max-age=31536000";
            
            # Увеличенные таймауты для статики
            proxy_connect_timeout 180s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
            
            # Отключаем буферизацию для статики
            proxy_buffering off;
            proxy_request_buffering off;
        }
        
        # Основной location для всех остальных запросов (SSR, API routes и т.д.)
        location / {
            proxy_pass http://flowix-landing:3002;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header CF-IPCountry $http_cf_ipcountry;
            proxy_set_header CF-RAY $http_cf_ray;
            
            # Важно для правильной работы Next.js (WebSocket support)
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            
            # Увеличенные таймауты для SSR (Next.js может долго рендерить первый запрос)
            proxy_connect_timeout 180s;
            proxy_send_timeout 180s;
            proxy_read_timeout 180s;
            
            # Отключаем буферизацию для SSR (чтобы пользователь видел прогресс)
            proxy_buffering off;
            proxy_request_buffering off;
            
            # Retry при ошибках
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 3;
            proxy_next_upstream_timeout 60s;
        }
    }

    # Сервер для лендинга (flowixdata.ru) - HTTPS
    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        # http2 on;  # Временно отключено из-за проблем с ERR_HTTP2_PING_FAILED
        server_name flowixdata.ru www.flowixdata.ru;
        # SSL сертификаты (Let's Encrypt)
        ssl_certificate /etc/letsencrypt/live/flowixdata.ru/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/flowixdata.ru/privkey.pem;

        # SSL настройки для безопасности
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # HSTS (строгий транспорт безопасности)
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # Логи
        access_log /var/log/nginx/landing_access.log combined;
        error_log /var/log/nginx/landing_error.log warn;

        # Специальная обработка статических файлов Next.js (высокий приоритет)
        location ~ ^/_next/ {
            proxy_pass http://flowix-landing:3002;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            
            # Кэширование статических файлов
            add_header Cache-Control "public, immutable, max-age=31536000";
            
            # Увеличенные таймауты для статики
            proxy_connect_timeout 180s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
            
            # Отключаем буферизацию для статики (может вызывать проблемы)
            proxy_buffering off;
            proxy_request_buffering off;
            
            # Закрываем соединение после каждого запроса
            proxy_set_header Connection "close";
        }

        # Основной location для всех остальных запросов (SSR, API routes и т.д.)
        location / {
            proxy_pass http://flowix-landing:3002;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header CF-IPCountry $http_cf_ipcountry;
            proxy_set_header CF-RAY $http_cf_ray;
            
            # Важно для правильной работы Next.js (WebSocket support)
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            
            # Увеличенные таймауты для SSR (Next.js может долго рендерить первый запрос)
            proxy_connect_timeout 180s;
            proxy_send_timeout 180s;
            proxy_read_timeout 180s;
            
            # Отключаем буферизацию для SSR (чтобы пользователь видел прогресс)
            proxy_buffering off;
            proxy_request_buffering off;
            
            # Retry при ошибках
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 3;
            proxy_next_upstream_timeout 60s;
        }
    }
} 