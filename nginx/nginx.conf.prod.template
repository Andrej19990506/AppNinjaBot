events {
    worker_connections 1024;
}

http {
    # DNS resolver для Docker сети
    resolver 127.0.0.11 valid=30s;
    
    # Исправление ошибки server_names_hash
    server_names_hash_bucket_size 128;
    
    # MIME types
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Cloudflare Real IP configuration
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2c0f:f248::/32;
    set_real_ip_from 2a06:98c0::/29;

    real_ip_header CF-Connecting-IP;

    # Основные настройки
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    types_hash_max_size 2048;
    server_tokens off;

    # Настройки буферов и таймаутов
    client_body_buffer_size 10K;
    client_header_buffer_size 8k;
    client_max_body_size 8m;
    large_client_header_buffers 4 16k;

    # Сжатие
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;

    # WebSocket
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

# Маппинг больше не нужен - используем прямую проверку в location

    # Основной сервер (appninjabot.ru)
    server {
        listen 80;
        listen [::]:80;
        server_name appninjabot.ru www.appninjabot.ru c8e767f0-ac37-4f85-88bd-7ce8bceb888c.selcdn.net;
        
        # Важно для корректной работы с URL-encoded символами
        charset utf-8;

        # Логи
        access_log /var/log/nginx/access.log combined buffer=512k flush=1m;
        error_log /var/log/nginx/error.log warn;

        # Frontend (Serve static files from within the image)
        location / {
            root /usr/share/nginx/html;   # Root directory for static files
            index index.html index.htm;     # Default file to serve
            try_files $uri $uri/ /index.html; # Handles SPA routing

            # Optional: Add caching headers for static assets
            location ~* \.(?:css|js|map|jpe?g|png|gif|ico|svg|woff2?|ttf|eot)$ {
                expires 7d; # Cache for 7 days
                access_log off; # Don't log access to static files
                add_header Cache-Control "public";
            }
        }

        # API endpoints without trailing slash
        location = /api {
            return 301 /api/;
        }

        # Write-offs photos specific rule (HIGH PRIORITY)
        location ^~ /v1/write-offs/photos/ {
            # Для URL начинающихся с /v1/ добавляем /api префикс, сохраняя оригинальный путь
            set $final_uri /api$uri;
            
            # Проксируем с исправленным URI
            proxy_pass http://server:8000$final_uri$is_args$args;

            # АНТИ-КЭШ ЗАГОЛОВКИ ДЛЯ ВСЕХ API
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            add_header X-Content-Type-Options "nosniff" always;

            # Стандартные заголовки проксирования
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header CF-IPCountry $http_cf_ipcountry;
            proxy_set_header CF-RAY $http_cf_ray;
            proxy_set_header CF-Visitor $http_cf_visitor;

            # Важно для WSS и HTTPS!
            proxy_set_header X-Forwarded-Ssl on;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Таймауты
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;

            # Буферизация
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 16 4k;
            proxy_busy_buffers_size 8k;

            # Кодировка для URL
            proxy_set_header Accept-Charset utf-8;
            
            # Дополнительная защита от 502 ошибок
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 1;
            proxy_next_upstream_timeout 10s;

            # Логирование для отладки
            access_log /var/log/nginx/api_access.log combined;
            error_log /var/log/nginx/api_error.log warn;
        }

        # WebSocket endpoints (ДОЛЖНЫ БЫТЬ ПЕРЕД ОБЩИМ ПРАВИЛОМ!)
        location ~ ^/(api/ws|socket\.io)/ {
            proxy_pass http://websocket:8001;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;

            # Передаем IP и заголовки с Cloudflare
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header CF-IPCountry $http_cf_ipcountry;
            proxy_set_header CF-RAY $http_cf_ray;
            proxy_set_header CF-Visitor $http_cf_visitor;

            # Важно для WSS!
            proxy_set_header X-Forwarded-Ssl on;

            # Увеличиваем таймауты
            proxy_read_timeout 300;
            proxy_send_timeout 300;
            proxy_connect_timeout 300;

            # Отключаем буферизацию
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            proxy_redirect off;

            # Для отладки сохраняем больше логов
            access_log /var/log/nginx/websocket_access.log;
            error_log /var/log/nginx/websocket_error.log debug;
        }

        # УНИВЕРСАЛЬНОЕ ПРАВИЛО ДЛЯ ВСЕХ API ЭНДПОИНТОВ
        # Покрывает: /api/*, /v1/*, /couriers/*, /users/* и любые другие API пути
        location ~* ^/(api|v1|couriers|users|shifts|reserves|groups|inventory|write-offs)(/.*)?$ {

            # Для URL начинающихся с /v1/ добавляем /api префикс, сохраняя оригинальный путь
            set $final_uri $uri;
            if ($uri ~ ^/v1/(.*)$) {
                set $final_uri /api$uri;
            }
            
            # Проксируем с исправленным URI
            proxy_pass http://server:8000$final_uri$is_args$args;

            # АНТИ-КЭШ ЗАГОЛОВКИ ДЛЯ ВСЕХ API
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            add_header X-Content-Type-Options "nosniff" always;

            # Стандартные заголовки проксирования
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header CF-IPCountry $http_cf_ipcountry;
            proxy_set_header CF-RAY $http_cf_ray;
            proxy_set_header CF-Visitor $http_cf_visitor;

            # Важно для WSS и HTTPS!
            proxy_set_header X-Forwarded-Ssl on;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Таймауты
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;

            # Буферизация
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 16 4k;
            proxy_busy_buffers_size 8k;

            # Кодировка для URL
            proxy_set_header Accept-Charset utf-8;
            
            # Дополнительная защита от 502 ошибок
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 1;
            proxy_next_upstream_timeout 10s;

            # Логирование для отладки
            access_log /var/log/nginx/api_access.log combined;
            error_log /var/log/nginx/api_error.log warn;
        }

        # User photos static files
        location /users-photo/ {
            alias /app/shared/users-photo/;
            expires 7d; # Cache for 7 days
            access_log off;
            add_header Cache-Control "public";
        }

        # Маршрут для отправки сообщений от шедулера к боту
        location /send_message {
            proxy_pass http://bot:8003/send_message;
            
            # Анти-кэш заголовки
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            expires 0;
            
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            
            # Логи
            access_log /var/log/nginx/scheduler_bot_proxy_access.log;
            error_log /var/log/nginx/scheduler_bot_proxy_error.log warn;
        }

        # Remove or update this location if test client is not needed
        location /test-client {
            alias /var/www/appninjabot/websocket-service/; # Check if this path exists/needed
            index index.html;
        }

        # Remove or update this location if health check is handled differently
        location /health {
            proxy_pass http://websocket:8001; # Or point to server health endpoint
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        # Remove or update this location if metrics are handled differently
        location /metrics {
            proxy_pass http://websocket:8001; # Or point to server metrics endpoint
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        # Диагностический endpoint для проверки config.js
        location = /debug/config-status {
            return 200 '{"status":"ok","config_path":"/usr/share/nginx/html/config.js","timestamp":"$time_iso8601","user_agent":"$http_user_agent"}';
            add_header Content-Type application/json;
            add_header Cache-Control "no-store, must-revalidate";
            access_log /var/log/nginx/config_debug_access.log combined;
        }

        location = /config.js {
            root /usr/share/nginx/html;
            
            # Агрессивные anti-cache заголовки для мобильных
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
            add_header Pragma "no-cache";
            add_header Expires "0";
            add_header Last-Modified $date_gmt;
            add_header ETag "";
            add_header X-Debug-ConfigJS "served-by-nginx-$time_iso8601";
            
            # Включаем логирование для отладки
            access_log /var/log/nginx/config_js_access.log combined;
            error_log /var/log/nginx/config_js_error.log debug;
            
            # Добавляем заголовки для мобильной отладки
            add_header X-Content-Type-Options nosniff;
            add_header X-Frame-Options DENY;
            add_header Vary "User-Agent";
            
            # Отключаем кэширование на уровне nginx
            expires off;
            etag off;
        }
    }

    # Сервер для бота
    server {
        listen 80;
        server_name bot.appninjabot.ru localhost;
        
        # Важно для корректной работы с URL-encoded символами
        charset utf-8;
        
        # Увеличиваем лимиты для больших URL
        client_max_body_size 100M;
        large_client_header_buffers 4 32k;

        # Обработка вебхука (ТЕПЕРЬ ЗДЕСЬ)
        location = ${WEBHOOK_PATH} { # Используем переменную!
             proxy_pass http://bot:8003; # Проксируем на бот (порт 8003)
             proxy_http_version 1.1;

             # Стандартные заголовки для проксирования
             proxy_set_header Host $host;
             proxy_set_header X-Real-IP $http_cf_connecting_ip; # Используем IP от Cloudflare
             proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
             proxy_set_header X-Forwarded-Proto $scheme;
             proxy_set_header Connection ""; # Сбрасываем Connection
             
             # КРИТИЧНО: Передаём секретный токен Telegram
             proxy_set_header X-Telegram-Bot-Api-Secret-Token $http_x_telegram_bot_api_secret_token;
             
             # Передаём все заголовки
             proxy_pass_request_headers on;

             # Таймауты для webhook
             proxy_read_timeout 60s;
             proxy_send_timeout 60s;
             proxy_connect_timeout 10s;

             # Логи вебхука
             access_log /var/log/nginx/bot_webhook_access.log combined;
             error_log /var/log/nginx/bot_webhook_error.log warn;
         }

        # Write-offs photos specific rule (HIGH PRIORITY)
        location ^~ /v1/write-offs/photos/ {
            # Для URL начинающихся с /v1/ добавляем /api префикс, сохраняя оригинальный путь
            set $final_uri /api$uri;
            
            # Проксируем с исправленным URI
            proxy_pass http://server:8000$final_uri$is_args$args;

            # АНТИ-КЭШ ЗАГОЛОВКИ ДЛЯ ВСЕХ API
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            add_header X-Content-Type-Options "nosniff" always;

            # Стандартные заголовки проксирования
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            # Важно для WSS и HTTPS!
            proxy_set_header X-Forwarded-Ssl on;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Таймауты
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;

            # Буферизация
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 16 4k;
            proxy_busy_buffers_size 8k;

            # Кодировка для URL
            proxy_set_header Accept-Charset utf-8;
            
            # Дополнительная защита от 502 ошибок
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 1;
            proxy_next_upstream_timeout 10s;

            # Логирование для отладки
            access_log /var/log/nginx/api_access.log combined;
            error_log /var/log/nginx/api_error.log warn;
        }

        # API endpoints для localhost (дублируем из основного сервера)
        location ~ ^/(api|v1|couriers|users|shifts|reserves|groups|inventory|write-offs)(/.*)?$ {
            # Для URL начинающихся с /v1/ добавляем /api префикс, сохраняя оригинальный путь
            set $final_uri $uri;
            if ($uri ~ ^/v1/(.*)$) {
                set $final_uri /api$uri;
            }
            
            # Проксируем с исправленным URI
            proxy_pass http://server:8000$final_uri$is_args$args;

            # АНТИ-КЭШ ЗАГОЛОВКИ ДЛЯ ВСЕХ API
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            add_header X-Content-Type-Options "nosniff" always;

            # Стандартные заголовки проксирования
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            # Важно для WSS и HTTPS!
            proxy_set_header X-Forwarded-Ssl on;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Таймауты
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;

            # Буферизация
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 16 4k;
            proxy_busy_buffers_size 8k;

            # Кодировка для URL
            proxy_set_header Accept-Charset utf-8;
            
            # Дополнительная защита от 502 ошибок
            proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
            proxy_next_upstream_tries 1;
            proxy_next_upstream_timeout 10s;

            # Логирование для отладки
            access_log /var/log/nginx/api_access.log combined;
            error_log /var/log/nginx/api_error.log warn;
        }

        # На все остальные запросы к этому поддомену отвечаем 404
        location / {
            return 404;
        }
    }
} 